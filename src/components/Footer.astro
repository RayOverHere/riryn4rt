---
import { getArtistProfile, getSocialLinks, getSiteSettings } from '../lib/db';

const profile = await getArtistProfile();
const socials = await getSocialLinks();
const settings = await getSiteSettings();
const logoUrl = settings?.logo_url?.url || null;
const currentYear = new Date().getFullYear();

const socialIcons: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  twitter: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  bluesky: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.204-.659-.299-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.27 8.27 0 0 0 4.84 1.55V6.79a4.85 4.85 0 0 1-1.07-.1z"/></svg>`,
};
---

<footer class="relative mt-24 overflow-hidden">
  <!-- Atmospheric top wave -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-babypink to-transparent"></div>
  <div class="absolute -top-32 left-1/4 w-96 h-96 rounded-full opacity-20 pointer-events-none" style="background: radial-gradient(circle, var(--color-babypink), transparent 70%); filter: blur(40px);"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 py-14 flex flex-col items-center text-center gap-8">

    <!-- Wordmark -->
    <div>
      {logoUrl ? (
        <img src={logoUrl} alt="Riryn4rt" class="h-10 w-auto object-contain mx-auto mb-2 opacity-80" />
      ) : (
        <div class="font-display font-bold text-2xl text-darkpink-deep">Riryn4rt</div>
      )}
      <p class="text-darkpink-muted max-w-sm mx-auto font-medium text-sm mt-2 leading-relaxed">
        {profile.short_intro}
      </p>
    </div>

    <!-- Nav Links -->
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-display font-semibold text-sm text-darkpink-muted" aria-label="Footer navigation">
      <a href="/" class="hover:text-roseaccent transition-colors">Home</a>
      <span class="text-candy hidden sm:inline">·</span>
      <a href="/gallery" class="hover:text-roseaccent transition-colors">Gallery</a>
      <span class="text-candy hidden sm:inline">·</span>
      <a href="/commissions" class="hover:text-roseaccent transition-colors">Commissions</a>
      <span class="text-candy hidden sm:inline">·</span>
      <a href="/#about" class="hover:text-roseaccent transition-colors">About</a>
      <span class="text-candy hidden sm:inline">·</span>
      <a href="/#faq" class="hover:text-roseaccent transition-colors">FAQ</a>
    </nav>

    <!-- Social Links -->
    {socials.length > 0 && (
      <div class="flex items-center gap-3">
        {socials.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full glass-surface flex items-center justify-center text-darkpink-muted hover:text-roseaccent hover:scale-110 transition-all shadow-sm"
            title={`Visit ${link.platform}`}
            set:html={socialIcons[link.platform.toLowerCase()] || `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`}
          />
        ))}
      </div>
    )}

    <!-- Copyright -->
    <div class="text-xs text-darkpink-muted/70 font-medium flex flex-col items-center gap-1 pt-4 border-t border-candy w-full">
      <p>© {currentYear} Riryn4rt. All rights reserved.</p>
      <p class="text-roseaccent/80">Made with soft pink dreams 🌸</p>
    </div>
  </div>
</footer>



