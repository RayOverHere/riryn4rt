---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getArtistProfile } from '../lib/db';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const profile = await getArtistProfile();
const artistName = 'Riryn4rt';

const {
  title = `${artistName} — Digital Artist & Commissions`,
  description = profile.short_intro || "Cute digital artist portfolio and custom art commissions by Riryn4rt.",
  image = "/favicon.svg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://riryn4rt.vercel.app');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={artistName} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:site_name" content={artistName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-babypink selection:text-darkpink-deep">
    <!-- Atmospheric background blobs -->
    <div class="atmo-blob w-[600px] h-[600px] opacity-50" style="top: -100px; left: -150px; background: radial-gradient(circle, rgba(255,200,216,0.7), transparent 70%);"></div>
    <div class="atmo-blob w-[500px] h-[500px] opacity-40" style="top: 20%; right: -100px; background: radial-gradient(circle, rgba(255,220,235,0.6), transparent 70%);"></div>
    <div class="atmo-blob w-[400px] h-[400px] opacity-35" style="bottom: 10%; left: 20%; background: radial-gradient(circle, rgba(255,228,240,0.5), transparent 70%);"></div>
    <div class="atmo-blob w-[350px] h-[350px] opacity-30" style="bottom: -50px; right: 10%; background: radial-gradient(circle, rgba(245,243,255,0.5), transparent 70%);"></div>

    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>


