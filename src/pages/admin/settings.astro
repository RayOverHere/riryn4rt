---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSupabaseAdmin } from '../../lib/supabase';

const sessionCookie = Astro.cookies.get('sb-session');
if (!sessionCookie?.value) {
  return Astro.redirect('/admin/login');
}

const admin = getSupabaseAdmin();
let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    if (action === 'update_whatsapp') {
      const whatsapp_number = formData.get('whatsapp_number') as string;
      const { error } = await admin.from('site_settings').upsert({
        key: 'whatsapp_number',
        value: { number: whatsapp_number },
        updated_at: new Date().toISOString()
      }, { onConflict: 'key' });
      
      if (error) throw error;
      successMsg = 'WhatsApp number updated successfully!';
    }
  } catch (e: any) {
    console.error('Settings update error:', e);
    errorMsg = e.message || 'Update failed.';
  }
}

// Fetch current whatsapp setting
let currentWhatsapp = '';
try {
  const { data } = await admin.from('site_settings').select('value').eq('key', 'whatsapp_number').maybeSingle();
  if (data?.value?.number) {
    currentWhatsapp = data.value.number;
  }
} catch (e) {
  console.error(e);
}

const supabaseUrl = import.meta.env.SUPABASE_URL || 'Not set';
const supabaseKeySet = !!import.meta.env.SUPABASE_ANON_KEY;
const supabaseServiceKeySet = !!import.meta.env.SUPABASE_SERVICE_ROLE_KEY;
const siteUrl = import.meta.env.SITE_URL || 'Not set';
---

<AdminLayout title="Settings | Admin">
  <div class="p-6 md:p-8 flex flex-col gap-8 max-w-3xl">
    <div>
      <h1 class="text-3xl font-display font-bold text-gray-800 tracking-tight">Settings & System Info</h1>
      <p class="text-gray-500 text-sm mt-1">Environment configuration and system status overview.</p>
    </div>
    
    {successMsg && (
      <div class="p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 font-semibold text-sm shadow-sm">✅ {successMsg}</div>
    )}
    {errorMsg && (
      <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 font-semibold text-sm shadow-sm">⚠️ {errorMsg}</div>
    )}

    <!-- General Settings -->
    <div class="bg-white/80 backdrop-blur-md border border-white/60 rounded-3xl p-8 flex flex-col gap-6 shadow-soft">
      <h2 class="font-display font-bold text-gray-700 text-sm uppercase tracking-wider">Site Settings</h2>
      
      <form method="POST" class="flex flex-col gap-6">
        <input type="hidden" name="action" value="update_whatsapp" />
        <div class="flex flex-col gap-2">
          <label class="text-xs font-bold text-gray-500 uppercase tracking-wider">WhatsApp Number</label>
          <input type="text" name="whatsapp_number" value={currentWhatsapp} 
            placeholder="e.g. +6281234567890" 
            class="border border-gray-200 rounded-xl px-4 py-3 text-sm font-semibold text-gray-700 outline-none focus:border-roseaccent focus:ring-2 focus:ring-roseaccent/20 transition-all bg-white/50" />
          <p class="text-[11px] text-gray-400 font-medium">Include country code. Used for redirecting commission requests.</p>
        </div>
        <button type="submit" class="self-start bg-darkpink hover:bg-roseaccent text-white font-bold text-sm px-6 py-3 rounded-xl transition-all shadow-sm">
          Save Settings
        </button>
      </form>
    </div>

    <!-- Environment Status -->
    <div class="bg-white/80 backdrop-blur-md border border-white/60 rounded-3xl p-8 flex flex-col gap-6 shadow-soft">
      <h2 class="font-display font-bold text-gray-700 text-sm uppercase tracking-wider">Environment Variables</h2>
      <div class="flex flex-col gap-4 text-sm">
        <div class="flex items-center justify-between pb-4 border-b border-gray-100/50">
          <span class="font-semibold text-gray-700">SUPABASE_URL</span>
          <span class="font-mono text-xs bg-blush/30 px-3 py-1.5 rounded-lg text-gray-600 max-w-xs truncate">{supabaseUrl}</span>
        </div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-100/50">
          <span class="font-semibold text-gray-700">SUPABASE_ANON_KEY</span>
          <span class={`font-bold text-xs px-3 py-1.5 rounded-lg ${supabaseKeySet ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`}>
            {supabaseKeySet ? '✓ Set' : '✗ Missing'}
          </span>
        </div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-100/50">
          <span class="font-semibold text-gray-700">SUPABASE_SERVICE_ROLE_KEY</span>
          <span class={`font-bold text-xs px-3 py-1.5 rounded-lg ${supabaseServiceKeySet ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`}>
            {supabaseServiceKeySet ? '✓ Set' : '✗ Missing'}
          </span>
        </div>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-gray-700">SITE_URL</span>
          <span class="font-mono text-xs bg-blush/30 px-3 py-1.5 rounded-lg text-gray-600">{siteUrl}</span>
        </div>
      </div>

      {(!supabaseKeySet || !supabaseServiceKeySet) && (
        <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-5 text-yellow-700 text-sm font-semibold shadow-sm">
          ⚠️ Some environment variables are missing. The site will use fallback data for database queries.
          Copy <code class="bg-yellow-100/50 px-2 py-0.5 rounded-md text-xs">.env.example</code> to <code class="bg-yellow-100/50 px-2 py-0.5 rounded-md text-xs">.env</code> and fill in your Supabase credentials.
        </div>
      )}
    </div>

    <!-- Setup Guide -->
    <div class="bg-white/80 backdrop-blur-md border border-white/60 rounded-3xl p-8 flex flex-col gap-6 shadow-soft">
      <h2 class="font-display font-bold text-gray-700 text-sm uppercase tracking-wider">Setup Guide</h2>
      <ol class="flex flex-col gap-5 text-sm">
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">1</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Create a Supabase project</p>
            <p class="text-gray-500 mt-1 font-medium">Go to <a href="https://supabase.com" target="_blank" class="text-darkpink hover:text-roseaccent transition-colors hover:underline">supabase.com</a> and create a new project.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">2</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Run the database schema</p>
            <p class="text-gray-500 mt-1 font-medium">Go to SQL Editor in Supabase and run the contents of <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">db/schema.sql</code>.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">3</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Seed initial data</p>
            <p class="text-gray-500 mt-1 font-medium">Run <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">db/seed.sql</code> to populate commission types, regions, and default profile.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">4</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Configure environment variables</p>
            <p class="text-gray-500 mt-1 font-medium">Copy <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">.env.example</code> → <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">.env</code> and fill in your project URL, anon key, and service role key.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">5</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Create admin user in Supabase Auth</p>
            <p class="text-gray-500 mt-1 font-medium">In Supabase → Authentication → Users, create a user with your email/password to use for admin login.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="w-8 h-8 rounded-full bg-blush text-darkpink font-bold text-sm flex items-center justify-center flex-shrink-0 shadow-sm border border-white">6</span>
          <div class="mt-1">
            <p class="font-bold text-gray-800">Set up Supabase Storage</p>
            <p class="text-gray-500 mt-1 font-medium">Create a <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">commissions</code> bucket (private) and an <code class="bg-gray-50 font-mono border border-gray-100 px-1.5 py-0.5 rounded-md text-xs">artworks</code> bucket (public) for image uploads.</p>
          </div>
        </li>
      </ol>
    </div>

    <!-- Danger Zone -->
    <div class="bg-white/80 backdrop-blur-md border border-red-100 rounded-3xl p-8 flex flex-col gap-6 shadow-soft">
      <h2 class="font-display font-bold text-red-600 text-sm uppercase tracking-wider">Session</h2>
      <a href="/admin/logout" class="self-start bg-red-50 hover:bg-red-100 border border-red-100 text-red-600 font-bold text-sm px-6 py-3 rounded-xl transition-all shadow-sm">
        🚪 Log Out of Admin
      </a>
    </div>
  </div>
</AdminLayout>
