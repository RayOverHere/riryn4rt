---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getSupabaseAdmin } from '../../../lib/supabase';

const sessionCookie = Astro.cookies.get('sb-session');
if (!sessionCookie?.value) {
  return Astro.redirect('/admin/login');
}

const admin = getSupabaseAdmin();
const statusFilter = Astro.url.searchParams.get('status') || 'all';

let requests: any[] = [];
let fetchError = '';
let successMsg = '';

// Handle toggling Commission Status
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    if (action === 'toggle_status') {
      const currentStatus = formData.get('current_status') as string;
      const newStatus = currentStatus === 'open' ? 'closed' : 'open';
      
      const { error } = await admin.from('site_settings').upsert({
        key: 'commissions_status',
        value: { status: newStatus },
        updated_at: new Date().toISOString()
      }, { onConflict: 'key' });
      
      if (error) throw error;
      successMsg = `Commissions are now ${newStatus.toUpperCase()}!`;
    }
  } catch (e: any) {
    fetchError = e.message || 'Failed to update status.';
  }
}

// Fetch Global Commission Status
let globalStatus = 'open';
try {
  const { data } = await admin.from('site_settings').select('value').eq('key', 'commissions_status').maybeSingle();
  if (data?.value?.status) {
    globalStatus = data.value.status;
  }
} catch (e) {
  console.error(e);
}

// Fetch Requests
try {
  let query = admin
    .from('commission_requests')
    .select(`
      id, client_name, client_email, client_country_code, 
      status, quoted_price, currency, created_at,
      commission_types(title)
    `)
    .order('created_at', { ascending: false });

  if (statusFilter !== 'all') {
    query = query.eq('status', statusFilter);
  }

  const { data, error } = await query;
  if (error) throw error;
  requests = data || [];
} catch (e: any) {
  if (!fetchError) fetchError = e.message || 'Failed to load requests.';
}

const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const statusColors: Record<string, string> = {
  new: 'bg-blue-50 text-blue-700 border-blue-200',
  reviewing: 'bg-yellow-50 text-yellow-700 border-yellow-200',
  accepted: 'bg-green-50 text-green-700 border-green-200',
  in_progress: 'bg-purple-50 text-purple-700 border-purple-200',
  completed: 'bg-gray-100 text-gray-600 border-gray-200',
  rejected: 'bg-red-50 text-red-700 border-red-200',
  cancelled: 'bg-stone-100 text-stone-600 border-stone-200'
};

const allStatuses = ['all', 'new', 'reviewing', 'accepted', 'in_progress', 'completed', 'rejected', 'cancelled'];
---

<AdminLayout title="Commission Requests | Admin">
  <div class="p-6 md:p-8 flex flex-col gap-6 max-w-6xl">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-display font-bold text-gray-800 tracking-tight">Commission Requests</h1>
        <p class="text-gray-500 text-sm mt-1">{requests.length} request{requests.length !== 1 ? 's' : ''} {statusFilter !== 'all' ? `with status: ${statusFilter}` : 'total'}</p>
      </div>

      <!-- Simplified OPEN/CLOSED Toggle -->
      <form method="POST" class="flex items-center">
        <input type="hidden" name="action" value="toggle_status" />
        <input type="hidden" name="current_status" value={globalStatus} />
        <button 
          type="submit" 
          class={`flex items-center gap-2 px-5 py-2.5 rounded-2xl font-display font-bold text-sm shadow-sm transition-all border ${
            globalStatus === 'open' 
            ? 'bg-green-50 text-green-700 border-green-200 hover:bg-green-100' 
            : 'bg-red-50 text-red-700 border-red-200 hover:bg-red-100'
          }`}
        >
          <span class={`w-2.5 h-2.5 rounded-full ${globalStatus === 'open' ? 'bg-green-500 animate-pulse' : 'bg-red-500'}`}></span>
          {globalStatus === 'open' ? 'COMMISSIONS OPEN' : 'COMMISSIONS CLOSED'}
        </button>
      </form>
    </div>

    {successMsg && (
      <div class="p-4 bg-green-50 border border-green-200 rounded-xl text-green-700 font-semibold text-sm shadow-sm">✅ {successMsg}</div>
    )}

    {fetchError && (
      <div class="p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 font-semibold text-sm shadow-sm">
        ⚠️ {fetchError}. Make sure Supabase is connected and the database is seeded.
      </div>
    )}

    <!-- Status Filter Tabs -->
    <div class="flex flex-wrap gap-2">
      {allStatuses.map(s => (
        <a
          href={`/admin/commissions${s !== 'all' ? `?status=${s}` : ''}`}
          class={`px-4 py-2 rounded-xl text-xs font-bold border transition-colors capitalize ${
            statusFilter === s
              ? 'bg-roseaccent text-white border-roseaccent shadow-sm'
              : 'bg-white/80 backdrop-blur-md text-gray-600 border-white/60 shadow-soft hover:border-roseaccent/40 hover:text-roseaccent'
          }`}
        >
          {s.replace('_', ' ')}
        </a>
      ))}
    </div>

    <!-- Requests Table -->
    <div class="bg-white/80 backdrop-blur-md shadow-soft border border-white/60 rounded-3xl overflow-hidden">
      {requests.length === 0 ? (
        <div class="p-16 text-center text-gray-400">
          <div class="text-5xl mb-4">💌</div>
          <p class="font-display font-bold text-xl text-gray-600">No commission requests found.</p>
          <p class="text-sm mt-2 text-gray-500">They will appear here once clients submit from the public commissions page.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-blush/30 border-b border-roseaccent/20">
              <tr>
                <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Client</th>
                <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider hidden md:table-cell">Style</th>
                <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider hidden sm:table-cell">Country</th>
                <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-5 py-4 text-left text-[11px] font-bold text-gray-500 uppercase tracking-wider hidden md:table-cell">Date</th>
                <th class="px-5 py-4 text-right text-[11px] font-bold text-gray-500 uppercase tracking-wider">Quote</th>
                <th class="px-5 py-4"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100/50">
              {requests.map((req) => (
                <tr class="hover:bg-blush/20 transition-colors group">
                  <td class="px-5 py-4">
                    <div class="font-semibold text-gray-800">{req.client_name}</div>
                    <div class="text-xs text-gray-400 font-mono mt-0.5">{req.client_email}</div>
                  </td>
                  <td class="px-5 py-4 text-gray-600 hidden md:table-cell font-medium">
                    {req.commission_types?.title || '—'}
                  </td>
                  <td class="px-5 py-4 text-gray-500 hidden sm:table-cell font-mono text-xs">
                    <span class="bg-gray-100 px-2 py-1 rounded-lg">{req.client_country_code}</span>
                  </td>
                  <td class="px-5 py-4">
                    <span class={`px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider border ${statusColors[req.status] || 'bg-gray-100 text-gray-600 border-gray-200'}`}>
                      {req.status.replace('_', ' ')}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-gray-400 text-xs hidden md:table-cell font-medium">{formatDate(req.created_at)}</td>
                  <td class="px-5 py-4 text-right font-display font-bold text-gray-800 text-base">
                    {req.currency === 'IDR' ? `Rp${Number(req.quoted_price).toLocaleString()}` : `$${req.quoted_price} ${req.currency}`}
                  </td>
                  <td class="px-5 py-4 text-right">
                    <a href={`/admin/commissions/${req.id}`} class="inline-flex items-center justify-center px-4 py-2 bg-white border border-gray-200 rounded-xl text-xs font-bold text-darkpink hover:bg-roseaccent hover:text-white hover:border-roseaccent transition-all shadow-sm">
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
